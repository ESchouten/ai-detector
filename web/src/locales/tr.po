#: src/lib/server/telegram.ts
#: src/lib/server/telegram.ts
msgid "Telegram returned an unexpected reply. Please try again later."
msgstr "Telegram beklenmedik bir yanıt verdi. Lütfen daha sonra tekrar deneyin."

#: src/lib/server/telegram.ts
msgid "Telegram could not be reached. Check this computer’s internet connection, then try again. Local monitoring can continue without alerts."
msgstr "Telegram’a ulaşılamadı. Bu bilgisayarın internet bağlantısını kontrol edip tekrar deneyin. Yerel izleme bildirimler olmadan devam edebilir."

#: src/lib/server/telegram.ts
msgid "This bot token is not valid. Copy the current token from BotFather."
msgstr "Bu bot token’ı geçerli değil. Güncel token’ı BotFather’dan kopyalayın."

#: src/lib/server/telegram.ts
msgid "This bot is receiving messages in another application or has a webhook. Use a dedicated bot for AI Detector, or enter its chat ID manually."
msgstr "Bu bot başka bir uygulamada mesaj alıyor veya bir webhook’u var. AI Detector için ayrı bir bot kullanın ya da sohbet kimliğini elle girin."

#: src/lib/server/telegram.ts
msgid "Telegram could not complete this request. Check your bot token and try again."
msgstr "Telegram bu isteği tamamlayamadı. Bot token’ınızı kontrol edip tekrar deneyin."

#: src/lib/server/telegram.ts
msgid "This bot is connected to another application through a webhook. Its connection has not been changed. Use a dedicated bot for AI Detector, or enter its chat ID manually."
msgstr "Bu bot bir webhook aracılığıyla başka bir uygulamaya bağlı. Bu bağlantı değiştirilmedi. AI Detector için ayrı bir bot kullanın ya da sohbet kimliğini elle girin."

#: src/lib/server/telegram.ts
msgid "AI Detector setup test. If you received this message on the intended device, confirm receipt in AI Detector to enable alerts."
msgstr "AI Detector kurulum testi. Bu mesajı doğru cihazda aldıysanız, bildirimleri etkinleştirmek için AI Detector’da alındığını onaylayın."

#: src/lib/server/telegram.ts
msgid "Choose a group for AI Detector alerts. Add this bot to your group first if it is not listed."
msgstr "AI Detector bildirimleri için bir grup seçin. Grup listede yoksa önce bu botu grubunuza ekleyin."

#: src/lib/server/telegram.ts
msgid "Choose a channel for AI Detector alerts. Telegram will ask for permission to post there."
msgstr "AI Detector bildirimleri için bir kanal seçin. Telegram oraya gönderi yapmak için izin isteyecek."

#: src/lib/server/telegram.ts
msgid "Choose group"
msgstr "Grup seç"

#: src/lib/server/telegram.ts
msgid "Choose channel"
msgstr "Kanal seç"

#: src/lib/server/telegram.ts
msgid "AI Detector test alert. Choose Confirm connection to receive detector alerts in this chat."
msgstr "AI Detector test bildirimi. Bu sohbette dedektör bildirimlerini almak için “Bağlantıyı onayla” düğmesine dokunun."

#: src/lib/server/telegram.ts
msgid "Confirm connection"
msgstr "Bağlantıyı onayla"

#: src/lib/server/telegram.ts
msgid "Connected. Return to AI Detector to save your settings."
msgstr "Bağlandı. Ayarlarınızı kaydetmek için AI Detector’a dönün."

#: src/lib/server/telegram-reviews.ts
msgid "This chat is not connected to AI Detector."
msgstr "Bu sohbet AI Detector’a bağlı değil."

#: src/lib/components/review-buttons.svelte
#: src/lib/server/telegram-reviews.ts
msgid "Could not save this review. Please try again."
msgstr "Bu değerlendirme kaydedilemedi. Lütfen tekrar deneyin."

#: src/lib/components/review-buttons.svelte
#: src/lib/components/review-buttons.svelte
#: src/lib/detections.ts
msgid "Confirmed"
msgstr "Onaylandı"

#: src/lib/components/review-buttons.svelte
msgid "Marked as a false alarm"
msgstr "Yanlış alarm olarak işaretlendi"

#: src/lib/server/telegram-reviews.ts
msgid "This recording is no longer available in AI Detector."
msgstr "Bu kayıt artık AI Detector’da mevcut değil."

#: src/lib/server/cameras/archive-check.ts
msgid "The recording location contains a file or linked folder. Choose a regular recording folder before testing it."
msgstr "Kayıt konumu bir dosya veya bağlantılı bir klasör içeriyor. Test etmeden önce normal bir kayıt klasörü seçin."

#: src/lib/server/cameras/archive-check.ts
msgid "The recording location is invalid. Check the camera settings."
msgstr "Kayıt konumu geçersiz. Kamera ayarlarını kontrol edin."

#: src/lib/server/cameras/connection.ts
msgid "The camera software is missing. Repair or reinstall AI Detector and try again."
msgstr "Kamera yazılımı eksik. AI Detector’ı onarın veya yeniden yükleyip tekrar deneyin."

#: src/lib/server/cameras/archive-check.ts
msgid "The test recording was saved but could not be played. Check the camera picture and try again."
msgstr "Test kaydı kaydedildi ancak oynatılamadı. Kamera görüntüsünü kontrol edip tekrar deneyin."

#: src/lib/server/cameras/archive-check.ts
msgid "The camera test recording is no longer available. Check its picture again."
msgstr "Kameranın test kaydı artık mevcut değil. Görüntüsünü yeniden kontrol edin."

#: src/routes/recovery/+page.server.ts
msgid "The saved settings could not be restored. Download diagnostics for help."
msgstr "Kayıtlı ayarlar geri yüklenemedi. Yardım için tanılama verilerini indirin."

#: src/lib/server/cameras/connection.ts
msgid "Enter the camera username and password in their separate fields."
msgstr "Kameranın kullanıcı adını ve parolasını kendi alanlarına girin."

#: src/lib/server/cameras/connection.ts
msgid "Enter the camera’s address, for example 192.168.1.50."
msgstr "Kameranın adresini girin, örneğin 192.168.1.50."

#: src/lib/server/cameras/connection.ts
msgid "Enter a complete camera stream address starting with rtsp:// or http://."
msgstr "rtsp:// veya http:// ile başlayan tam bir kamera yayın adresi girin."

#: src/lib/server/cameras/connection.ts
msgid "There is not enough space to save the test recording. Free some space on this computer and try again."
msgstr "Test kaydını kaydetmek için yeterli alan yok. Bu bilgisayarda biraz yer açıp tekrar deneyin."

#: src/lib/server/cameras/connection.ts
msgid "The camera rejected the login. Check its username and password, then try again."
msgstr "Kamera giriş bilgilerini reddetti. Kullanıcı adını ve parolayı kontrol edip tekrar deneyin."

#: src/lib/server/cameras/connection.ts
msgid "The camera did not respond. Check its power, network connection and address, then try again."
msgstr "Kamera yanıt vermedi. Gücünü, ağ bağlantısını ve adresini kontrol edip tekrar deneyin."

#: src/lib/server/cameras/connection.ts
msgid "The camera did not provide a supported video stream. Try another channel or ask your camera installer for its stream address."
msgstr "Kamera desteklenen bir video yayını sağlamadı. Başka bir kanal deneyin veya kamerayı kuran kişiden yayın adresini isteyin."

#: src/lib/server/cameras/connection.ts
msgid "Could not connect to this camera. Check that local camera access is enabled, or enter its stream URL manually."
msgstr "Bu kameraya bağlanılamadı. Yerel kamera erişiminin açık olduğunu kontrol edin veya yayın URL’sini elle girin."

#: src/lib/server/cameras/connection.ts
msgid "The test recording could not be saved. Check that AI Detector’s data folder is writable, or repair the installation."
msgstr "Test kaydı kaydedilemedi. AI Detector’ın veri klasörüne yazılabildiğini kontrol edin veya kurulumu onarın."

#: src/lib/server/configuration/advanced.ts
msgid "Each AI connection needs a unique name."
msgstr "Her yapay zekâ bağlantısının farklı bir adı olmalı."

#: src/lib/server/configuration/camera-setup.ts
#: src/lib/server/configuration/cameras.ts
#: src/lib/server/configuration/cameras.ts
msgid "This camera no longer exists."
msgstr "Bu kamera artık mevcut değil."

