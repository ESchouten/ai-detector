{
    "detection": {
        "interval": 5
    },
    "yolo": {
        "model": "https://github.com/CowCatcherAI/CalvingCatcherAI/releases/download/CalvingcatcherV1/calvingcatcherV11.pt",
        "confidence": {
            "waterbag": 0.65,
            "legs": 0.65,
            "head": 0.65,
            "body": 0.65,
            "calf": 0.85
        },
        "cooldown": {
            "calf": 900,
            "waterbag": 900,
            "legs": 900,
            "head": 900,
            "body": 900
        },
        "frames_min": 5,
        "timeout": 30
    },
    "exporters": {
        "disk": {
            "directory": "calvings"
        },
        "telegram": {
            "include_video": false,
            "include_plot": true
        }
    },
    "vlm": {
        "key": null,
        "prompt": "Does the footage show visible signs of a cow giving birth: a water bag, calf legs, head or body emerging, or a newly born calf beside the cow? Set detected to true only when such a sign is visible.",
        "strategy": "VIDEO"
    }
}
