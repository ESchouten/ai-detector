{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@9.15.9",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start": "node node-server.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"shadcn": "pnpx shadcn-svelte@latest update --all --yes && pnpm format",
		"test": "node --test tests/*.test.ts",
		"test:production": "node --test tests/production/*.test.mjs",
		"architecture": "svelte-kit sync && depcruise src --config .dependency-cruiser.cjs",
		"architecture:graph": "svelte-kit sync && node -e \"require('node:fs').mkdirSync('.reports', {recursive:true})\" && depcruise src/lib/server --config .dependency-cruiser.cjs --include-only \"^(src/|../config/)\" --output-type mermaid --output-to .reports/dependencies.mmd",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/lib/**/*.ts\" tests/*.test.ts",
		"quality": "pnpm lint && pnpm check && pnpm architecture && pnpm test",
		"architecture:metrics": "svelte-kit sync && depcruise src --config .dependency-cruiser.cjs --output-type metrics"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-node": "^5.5.3",
		"@sveltejs/kit": "^2.52.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^22.19.11",
		"@types/qrcode": "1.5.6",
		"bits-ui": "^2.15.5",
		"clsx": "^2.1.1",
		"dependency-cruiser": "^18.4.0",
		"devalue": "5.6.2",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"formsnap": "^2.0.1",
		"globals": "^16.5.0",
		"layerchart": "2.0.0-next.43",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.2",
		"svelte-check": "^4.4.0",
		"svelte-dnd-action": "^0.9.69",
		"svelte-sonner": "^1.0.7",
		"sveltekit-superforms": "^2.29.1",
		"tailwind-merge": "^3.4.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.55.0",
		"valibot": "^1.2.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@jesterkit/exe-sveltekit": "^0.1.7",
		"ajv": "^8.17.1",
		"ffmpeg-static": "^5.3.0",
		"monaco-editor": "^0.55.1",
		"onvif": "0.8.3",
		"qrcode": "1.5.4"
	},
	"pnpm": {
		"patchedDependencies": {
			"@jesterkit/exe-sveltekit@0.1.7": "patches/@jesterkit__exe-sveltekit@0.1.7.patch",
			"dependency-cruiser@18.4.0": "patches/dependency-cruiser@18.4.0.patch"
		}
	},
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=9.15.9 <10"
	}
}
