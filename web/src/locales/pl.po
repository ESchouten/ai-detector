#: src/lib/server/nvidia-runtime.ts
msgid "The NVIDIA runtime files are missing. Reinstall AI Detector."
msgstr "Brakuje plików środowiska NVIDIA. Zainstaluj AI Detector ponownie."

#: src/lib/server/nvidia-runtime.ts
msgid "Preparing NVIDIA acceleration. The first download may take several minutes…"
msgstr "Przygotowywanie akceleracji NVIDIA. Pierwsze pobieranie może potrwać kilka minut…"

#: src/lib/server/nvidia-runtime.ts
msgid "Downloading and installing NVIDIA acceleration…"
msgstr "Pobieranie i instalowanie akceleracji NVIDIA…"

#: src/lib/server/nvidia-runtime.ts
msgid "Checking NVIDIA acceleration…"
msgstr "Sprawdzanie akceleracji NVIDIA…"

#: src/lib/server/nvidia-runtime.ts
msgid "TensorRT preparation is deferred after an earlier failure. Using PyTorch/CUDA."
msgstr "Przygotowanie TensorRT odłożono po wcześniejszym błędzie. Używany jest PyTorch/CUDA."

#: src/lib/server/nvidia-runtime.ts
msgid "Preparing faster NVIDIA detection. Downloading TensorRT once for this computer…"
msgstr "Przygotowywanie szybszego wykrywania NVIDIA. Jednorazowe pobieranie TensorRT na ten komputer…"

