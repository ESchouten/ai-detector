msgstr "Telegram’ım"

#: src/lib/server/telegram-pairing.ts
msgid "This bot already has a connection in progress. Finish or cancel it before starting another."
msgstr "Bu bot için zaten devam eden bir bağlantı var. Yenisini başlatmadan önce onu tamamlayın veya iptal edin."

#: src/lib/server/stream-preview.ts
msgid "Invalid live picture received."
msgstr "Geçersiz canlı görüntü alındı."

#: src/lib/server/stream-preview.ts
msgid "Live stream ended."
msgstr "Canlı yayın sona erdi."

#: src/lib/server/stream-preview.ts
