<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <AssemblyName>AI Detector Tray</AssemblyName>
    <RootNamespace>AIDetector.Desktop</RootNamespace>
    <ApplicationIcon>../artwork/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="../artwork/app.ico" LogicalName="app.ico" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <InternalsVisibleTo Include="Tray.Tests" />
  </ItemGroup>
</Project>
