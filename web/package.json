{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@9.15.9",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start": "node node-server.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && wuchale && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"schema:generate": "node tools/generate-schema-types.mjs",
		"schema:check": "node tools/generate-schema-types.mjs --check",
		"i18n": "wuchale --clean",
		"i18n:check": "wuchale check --full",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"shadcn": "pnpx shadcn-svelte@latest update --all --yes && pnpm format",
		"test": "node --test tests/*.test.ts",
		"test:desktop": "node --test desktop/*.test.ts",
		"check:desktop": "tsc --project desktop/tsconfig.json",
		"test:production": "node --test tests/production/*.test.mjs",
		"test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
		"architecture": "svelte-kit sync && wuchale && depcruise src desktop --config .dependency-cruiser.cjs",
		"architecture:graph": "svelte-kit sync && node -e \"require('node:fs').mkdirSync('.reports', {recursive:true})\" && depcruise src/lib/server --config .dependency-cruiser.cjs --include-only \"^(src/|../config/)\" --output-type mermaid --output-to .reports/dependencies.mmd",
		"quality:static": "pnpm schema:check && pnpm lint && pnpm i18n:check && pnpm check && pnpm check:desktop && pnpm architecture",
		"quality": "pnpm quality:static && pnpm test && pnpm test:desktop"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@khmyznikov/pwa-install": "0.7.0",
		"@lucide/svelte": "^1.56.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^8.21.3",
		"@types/archiver": "^8.0.0",
		"@types/bun": "1.3.9",
		"@types/node": "^24.19.2",
		"@types/qrcode": "1.5.6",
		"@types/write-file-atomic": "^4.0.3",
		"@wuchale/svelte": "0.21.4",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"dependency-cruiser": "^18.6.0",
		"devalue": "5.9.4",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"fflate": "^0.8.3",
		"formsnap": "^2.0.1",
		"globals": "^17.13.0",
		"json-schema-to-typescript": "16.0.0",
		"layerchart": "2.0.0-next.43",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright-core": "1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.29.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"valibot": "^1.5.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.4",
		"vite-plugin-devtools-json": "^1.1.2",
		"wuchale": "0.26.7"
	},
	"dependencies": {
		"@homebridge/ciao": "1.3.12",
		"@jesterkit/exe-sveltekit": "^0.1.7",
		"@remix-run/multipart-parser": "1.0.0",
		"ajv": "^8.17.1",
		"archiver": "^8.0.0",
		"ffmpeg-static": "^5.3.0",
		"grammy": "^1.46.0",
		"monaco-editor": "^0.57.0",
		"onvif": "0.8.3",
		"qrcode": "1.5.4",
		"write-file-atomic": "^8.0.0"
	},
	"pnpm": {
		"patchedDependencies": {
			"@jesterkit/exe-sveltekit@0.1.7": "patches/@jesterkit__exe-sveltekit@0.1.7.patch",
			"@homebridge/ciao@1.3.12": "patches/@homebridge__ciao@1.3.12.patch"
		}
	},
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=9.15.9 <10"
	}
}
