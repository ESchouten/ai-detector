<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>12</LangVersion>
    <AssemblyName>AI Detector</AssemblyName>
    <RootNamespace>AIDetector.Desktop</RootNamespace>
    <ApplicationIcon>../artwork/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Content Include="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../artwork/app.ico" LogicalName="app.ico" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <InternalsVisibleTo Include="Launcher.Tests" />
  </ItemGroup>
</Project>
