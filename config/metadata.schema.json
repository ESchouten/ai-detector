{
  "$defs": {
    "CropMetadata": {
      "properties": {
        "x1": {
          "title": "X1",
          "type": "integer"
        },
        "y1": {
          "title": "Y1",
          "type": "integer"
        },
        "x2": {
          "title": "X2",
          "type": "integer"
        },
        "y2": {
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "CropMetadata",
      "type": "object"
    },
    "IdentityMetadata": {
      "description": "Matched individual visible in the event's best observation.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity"
        }
      },
      "required": [
        "id"
      ],
      "title": "IdentityMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "title": "Timestamp",
      "type": "string"
    },
    "event_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "validated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Validated"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "confidences": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Confidences",
      "type": "object"
    },
    "detections": {
      "minimum": 1,
      "title": "Detections",
      "type": "integer"
    },
    "start": {
      "title": "Start",
      "type": "string"
    },
    "end": {
      "title": "End",
      "type": "string"
    },
    "duration": {
      "minimum": 0,
      "title": "Duration",
      "type": "number"
    },
    "crop": {
      "anyOf": [
        {
          "$ref": "#/$defs/CropMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Error"
    },
    "identities": {
      "items": {
        "$ref": "#/$defs/IdentityMetadata"
      },
      "title": "Identities",
      "type": "array"
    }
  },
  "required": [
    "timestamp",
    "validated",
    "confidence",
    "confidences",
    "detections",
    "start",
    "end",
    "duration"
  ],
  "title": "EventMetadata",
  "type": "object"
}
