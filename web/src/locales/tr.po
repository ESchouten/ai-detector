#: src/lib/server/nvidia-runtime.ts
msgid "Preparing NVIDIA acceleration. The first download may take several minutes…"
msgstr "NVIDIA hızlandırması hazırlanıyor. İlk indirme birkaç dakika sürebilir…"

#: src/lib/server/nvidia-runtime.ts
msgid "Downloading and installing NVIDIA acceleration…"
msgstr "NVIDIA hızlandırması indiriliyor ve yükleniyor…"

#: src/lib/server/nvidia-runtime.ts
msgid "Checking NVIDIA acceleration…"
msgstr "NVIDIA hızlandırması kontrol ediliyor…"

#: src/lib/server/nvidia-runtime.ts
msgid "TensorRT preparation is deferred after an earlier failure. Using PyTorch/CUDA."
msgstr "Daha önceki bir hata nedeniyle TensorRT hazırlığı ertelendi. PyTorch/CUDA kullanılıyor."

#: src/lib/server/nvidia-runtime.ts
msgid "Preparing faster NVIDIA detection. Downloading TensorRT once for this computer…"
msgstr "Daha hızlı NVIDIA algılaması hazırlanıyor. TensorRT bu bilgisayar için bir kez indiriliyor…"

